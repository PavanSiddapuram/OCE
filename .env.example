# DeepSeek — sole LLM provider (platform.deepseek.com)
# Valid models: deepseek-v4-flash (fast/cheap) | deepseek-v4-pro (higher quality)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash

# External tools
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...

# Infrastructure
DATABASE_URL=postgresql+asyncpg://oce:oce_dev@localhost:5432/oce
REDIS_URL=redis://localhost:6379

# Pipeline tuning
MAX_COMPANIES_PER_RUN=20
TOP_OPPORTUNITIES_FOR_POW=5
